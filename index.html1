</div>

</div>

<!-- SKILLS -->
<div id="skills" class="section">

<h2 class="typewriter">Technical Skills</h2>

<div class="skills-grid">

<div class="skill"><i class="fab fa-html5"></i>HTML</div>
<div class="skill"><i class="fab fa-css3-alt"></i>CSS</div>
