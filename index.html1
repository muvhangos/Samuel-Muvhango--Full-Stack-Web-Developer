</div>

</div>

<!-- CERTIFICATIONS -->
<div id="certifications" class="section">

<h2 class="typewriter">Certifications</h2>

<div class="cert-grid">

<div class="cert-card"><i class="fas fa-network-wired"></i>CompTIA Network+</div>
<div class="cert-card"><i class="fas fa-tools"></i>CompTIA A+</div>
<div class="cert-card"><i class="fab fa-microsoft"></i>MCSE</div>

</div>

</div>

