<footer>
© 2026 Samuel Muvhango | Full-Stack Developer
</footer>

<script>

const fadeElements=document.querySelectorAll(".project-card,.skill,.cert-card");

window.addEventListener("scroll",()=>{

fadeElements.forEach((el,idx)=>{

const top=el.getBoundingClientRect().top;

if(top<window.innerHeight-100){

setTimeout(()=>{
el.style.opacity="1";
el.style.transform="translateY(0)";
},idx*100);

}

});

let scrollTop=document.documentElement.scrollTop;

let height=document.documentElement.scrollHeight-document.documentElement.clientHeight;

document.getElementById("progressBar").style.width=(scrollTop/height*100)+"%";

document.querySelectorAll(".section").forEach(sec=>{
if(sec.getBoundingClientRect().top<window.innerHeight-100)
sec.classList.add("show");
});

});

function toggleMode(){
document.body.classList.toggle("light");
}

tsParticles.load("particles-js",{
particles:{
number:{value:80},
color:{value:"#38bdf8"},
shape:{type:"circle"},
opacity:{value:0.5},
size:{value:3},
move:{enable:true,speed:2}
},
interactivity:{events:{onhover:{enable:true,mode:"repulse"}}},
detectRetina:true
});

</script>

</body>
</html>
