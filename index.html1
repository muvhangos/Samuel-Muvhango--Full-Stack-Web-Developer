<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Samuel Muvhango | Full-Stack Developer</title>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/tsparticles@2.11.1/tsparticles.min.js"></script>

<style>
*{margin:0;padding:0;box-sizing:border-box;scroll-behavior:smooth;}
body{font-family:Arial,sans-serif;background:#0f172a;color:white;line-height:1.6;transition:0.4s;}
body.light{background:#f5f5f5;color:#111;}

.progress-bar{position:fixed;top:0;left:0;height:5px;background:#38bdf8;width:0%;z-index:2000;}

nav{background:#1e293b;padding:15px;text-align:center;position:sticky;top:0;z-index:1000;}
nav a{color:white;margin:0 15px;text-decoration:none;font-weight:bold;}
nav a:hover{color:#38bdf8;}

.toggle{position:fixed;right:20px;top:15px;background:#38bdf8;color:#000;border:none;padding:8px 15px;border-radius:20px;cursor:pointer;font-weight:bold;z-index:2001;}

#particles-js{position:fixed;width:100%;height:100%;z-index:-1;top:0;left:0;}

.hero{text-align:center;padding:100px 20px;position:relative;z-index:1;}
.hero h1{font-size:40px;}
.hero h2{color:#38bdf8;margin:10px 0;}

.btn{display:inline-block;margin-top:20px;padding:10px 20px;background:#38bdf8;color:#000;text-decoration:none;border-radius:5px;font-weight:bold;transition:0.3s;}
.btn:hover{background:white;}

.section{padding:60px 20px;max-width:1100px;margin:auto;opacity:0;transform:translateY(40px);transition:1s;}
.section.show{opacity:1;transform:translateY(0);}

.section h2{text-align:center;margin-bottom:30px;color:#38bdf8;}

.projects{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px;}

.project-card{background:#1e293b;padding:20px;border-radius:8px;transition:0.3s;opacity:0;transform:translateY(40px);}
.project-card:hover{transform:translateY(-10px);box-shadow:0 10px 25px rgba(56,189,248,0.5);}

.skills-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:15px;}
.skill{background:#1e293b;padding:15px;border-radius:8px;text-align:center;transition:0.3s;opacity:0;transform:translateY(40px);}
.skill i{font-size:30px;margin-bottom:10px;color:#38bdf8;}
.skill:hover{background:#38bdf8;color:#000;transform:scale(1.05);}

.cert-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px;}
.cert-card{background:#1e293b;padding:20px;border-radius:12px;text-align:center;transition:0.3s;border:1px solid #222;opacity:0;transform:translateY(40px);}
.cert-card:hover{transform:translateY(-10px);box-shadow:0 10px 25px rgba(56,189,248,0.5);}

.contact{text-align:center;}

.contact input,
.contact textarea{
width:100%;
padding:10px;
margin:10px 0;
border:none;
border-radius:5px;
}

.whatsapp{position:fixed;bottom:20px;right:20px;background:#25D366;color:#fff;padding:15px;border-radius:50%;font-size:25px;z-index:2000;}

footer{text-align:center;padding:20px;background:#1e293b;margin-top:40px;}

.typewriter h2{overflow:hidden;border-right:.15em solid #38bdf8;white-space:nowrap;margin:0 auto;letter-spacing:.15em;animation:typing 3s steps(40,end),blink .75s step-end infinite;}
@keyframes typing{from{width:0}to{width:100%}}
@keyframes blink{50%{border-color:transparent}}
</style>
</head>

<body>

<div id="particles-js"></div>
<div class="progress-bar" id="progressBar"></div>
<button class="toggle" onclick="toggleMode()">Toggle Mode</button>

<nav>
<a href="#about">About</a>
<a href="#experience">Experience</a>
<a href="#projects">Projects</a>
<a href="#skills">Skills</a>
<a href="#certifications">Certifications</a>
<a href="#hire">Hire Me</a>
<a href="#contact">Contact</a>
</nav>

<!-- HERO -->
<div id="about" class="section hero">

<img src="images/profile.jpeg" style="width:160px;border-radius:50%;border:3px solid #38bdf8;margin-bottom:20px;">

<h1>Samuel Muvhango</h1>

